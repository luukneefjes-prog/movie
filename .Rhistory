min(movies3$revenue, na.rm = TRUE)
movies3[which.max(movies3$revenue), c("title", "revenue")]
movies3[which.min(movies3$revenue), c("title", "revenue")]
hist(movies3$revenue / 1e6,
main = "Histogram movie revenue",
xlab = "revenue (millions $)",
ylab = "Frequency",
col = "lightblue")
movies3$log_revenue <- log(movies3$revenue)
mean(movies3$log_revenue, na.rm = TRUE)
movies3$log_revenue[is.infinite(movies3$log_revenue)] <- NA
mean(movies3$log_revenue, na.rm = TRUE)
hist(movies3$log_revenue,
main = "Histogram movie revenue",
xlab = "Log(Revenue)",
ylab = "Frequency",
col = "lightblue")
library(moments)
skewness(movies3$revenue, na.rm = TRUE)
kurtosis(movies3$revenue, na.rm = TRUE)
skewness(movies3$log_revenue, na.rm = TRUE)
kurtosis(movies3$log_revenue, na.rm = TRUE)
mean(movies3$vote_average, na.rm = TRUE)
set.seed(123)
movies_sample <- movies3[sample(1:nrow(movies3), 25), ]
mean(movies_sample$vote_average, na.rm = TRUE)
sample_means <- numeric(100)
for (x in 1:100) {
sample_1 <- movies3[sample(nrow(movies3), 25), ]
sample_means[x] <- mean(sample_1$vote_average, na.rm = TRUE)
}
print(head(sample_means))
summary(sample_means)
sd(sample_means)
hist(sample_means,
main = "Histogram sample means",
xlab = "sample mean vote average")
hist(movies3$release_month, probability = TRUE,
main = "histogram release month",
xlab = "release Month",
col = "lightblue")
abline(h = 1/12,
col = "red",
lwd = 2)
revenue_data <- movies3$revenue[!is.na(movies3$revenue)]
n <- length(revenue_data)
mean_rev <- mean(revenue_data)
se_rev <- sd(revenue_data) / sqrt(n)
ci_90 <- mean_rev + c(-1,1) * qt(0.95, df = n -1) * se_rev
ci_90
table(movies_sample$director_gender)
binom.test(1, 21, p = 0.5)
movies_sample$revenue_mil <- movies_sample$revenue / 1000000
tapply(movies_sample$revenue_mil, movies_sample$director_gender, var, na.rm = TRUE)
n_female <- sum(movies_sample$director_gender == "female", na.rm = TRUE)
df <- n_female - 1
test_statistic <- NA
p_value <- NA
print(df)
print(test_statistic)
print(p_value)
yearly_revenue <- aggregate(revenue_mil ~ release_year, data = movies_sample, FUN = mean)
plot(yearly_revenue$release_year, yearly_revenue$revenue_mil,
xlab = "year",
ylab = "mean revenue",
main = "mean revenue by rear",
pch = 19, col = "red")
stats <- aggregate(revenue_mil ~ release_year, data = movies_sample, function(x) {
m <- mean(x)
se <- sd(x) / sqrt(length(x))
c(mean = m, lower = m - 1.96 * se, upper = m + 1.96 * se)
})
plot_data <- data.frame(year = stats$release_year, stats$revenue_mil)
ggplot(plot_data, aes(x = year, y = mean)) +
geom_point(color = "red", size = 2) +
geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.2, color = "blue") +
labs(title = "mean revenue with 95% confidence intervals",
x = "year",
y = "mean revenue") +
theme_minimal()
table(movies_sample$release_year)
model_level <- lm(revenue ~ budget, data = movies3.tsv)
model_level <- lm(revenue ~ budget, data = movies3)
summary(model_level)
