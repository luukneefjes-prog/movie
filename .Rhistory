revenue_data <- movies3$revenue[!is.na(movies3$revenue)]
n <- length(revenue_data)
mean_rev <- mean(revenue_data)
se_rev <- sd(revenue_data) / sqrt(n)
ci_90 <- mean_rev + c(-1,1) * qt(0.95, df = n -1) * se_rev
ci_90
